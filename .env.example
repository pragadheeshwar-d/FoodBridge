# Copy this to .env and fill in the values
# For local development:
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Initial admin account (required to provision an administrator on backend startup).
# Use a unique, strong password and do not commit your real .env file.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisToAStrongUniquePassword
ADMIN_NAME=FoodBridge Admin

# For production (replace with your Render backend URL):
# VITE_API_URL=https://foodbridge-api.onrender.com
# VITE_SOCKET_URL=https://foodbridge-api.onrender.com
